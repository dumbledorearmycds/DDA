rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared game hub documents (requests, suggestions, jackpots, event controls)
    match /da_hub/{docId} {
      allow read: if true;
      allow write: if docId in [
        'requests',
        'shopRequests',
        'suggestions',
        'jackpotEntries',
        'jjEntries',
        'eventControls',
        'globalSpin',
        'auraWeeklyReset',
        'grantHistory',
        'notifications'
      ] || docId.matches('^lb_.*') || docId.matches('^lbpending_.*');
    }

    // Individual player documents
    match /da_users/{userId} {
      allow read: if true;
      
      // Allow registration of new user documents with valid required fields
      allow create: if request.resource.data.keys().hasAll(['playerId', 'username', 'pinHash', 'coins'])
                    && request.resource.data.playerId == userId
                    && request.resource.data.coins >= 0
                    && request.resource.data.coins <= 1000
                    && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
                    && (!('aura' in request.resource.data) || request.resource.data.aura == 0)
                    && (!('pendingAuraGrant' in request.resource.data))
                    && (!('pendingAuraDeduct' in request.resource.data));

      // Allow updates to user's own document with monotonic txSeq on protected fields
      allow update: if resource != null
                    && resource.data.playerId == userId
                    && request.resource.data.playerId == userId
                    && (!('coins' in request.resource.data) || request.resource.data.coins >= 0)
                    && (!('txSeq' in resource.data) || resource.data.txSeq is int)
                    && !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys())
                    && (
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'coins', 'coinHistory', 'cardsWon', 'ownedCards',
                          'ownedShopItems', 'dailyCooldowns', 'claimedRefundReqIds', 'pendingShopOutbox'
                        ])
                        && request.resource.data.txSeq is int
                        && request.resource.data.txSeq == (
                          ('txSeq' in resource.data) ? resource.data.txSeq : 0
                        ) + 1
                      )
                      ||
                      (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'coins', 'coinHistory', 'cardsWon', 'ownedCards',
                          'ownedShopItems', 'dailyCooldowns', 'claimedRefundReqIds', 'pendingShopOutbox'
                        ])
                        && !('txSeq' in request.resource.data.diff(resource.data).affectedKeys())
                      )
                    );

      // Delete protection
      allow delete: if false;

      // Shop purchase receipts (permanent, immutable, subcollection)
      match /shopReceipts/{receiptId} {
        allow read: if true;
        allow create: if request.resource.data.reqId == receiptId
                      && request.resource.data.status == 'delivered'
                      && request.resource.data.cost >= 0;
        allow update, delete: if false;
      }

      // Bulk grant receipts (permanent, immutable, subcollection)
      match /bulkGrantReceipts/{grantId} {
        allow read: if true;
        allow create: if request.resource.data.bulkGrantId == grantId
                      && request.resource.data.amount is int
                      && request.resource.data.amount > 0;
        allow update, delete: if false;
      }

      // Bulk deduction receipts (permanent, immutable, subcollection)
      match /bulkDeductReceipts/{deductId} {
        allow read: if true;
        allow create: if request.resource.data.bulkDeductId == deductId
                      && request.resource.data.amount is int
                      && request.resource.data.amount > 0;
        allow update, delete: if false;
      }

      // Single grant & deduction receipts (permanent, immutable, subcollection)
      match /singleGrantReceipts/{receiptId} {
        allow read: if true;
        allow create: if request.resource.data.opId == receiptId;
        allow update, delete: if false;
      }
    }

    // Dedicated card requests collection (Scalable, no 1MB doc limit)
    match /da_card_requests/{reqId} {
      allow read: if true;
      allow create: if (request.resource.data.keys().hasAll(['id', 'playerId', 'setIdx', 'cardIdx', 'status'])
                        || request.resource.data.keys().hasAll(['id', 'status', 'adminCleared', 'adminClearedAt']))
                    && request.resource.data.id == reqId
                    && request.resource.data.status in ['pending', 'done', 'declined']
                    && (!('coinsSpent' in request.resource.data) || request.resource.data.coinsSpent >= 0);
      allow update: if resource != null
                    && request.resource.data.id == reqId
                    && request.resource.data.status in ['pending', 'done', 'declined'];
      allow delete: if true;
    }

    // Room of Requirements requests
    match /da_ror_requests/{reqId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'playerId', 'requestedCoins', 'status', 'timestamp'])
                    && request.resource.data.id == reqId
                    && request.resource.data.requestedCoins >= 0
                    && request.resource.data.requestedCoins <= 20000
                    && request.resource.data.status in ['pending', 'granted', 'declined', 'processing_granted', 'processing_declined'];
      allow update: if resource != null
                    && request.resource.data.id == reqId
                    && request.resource.data.status in ['pending', 'granted', 'declined', 'processing_granted', 'processing_declined'];
      allow delete: if true;
    }

    // Dedicated admin broadcast notifications & announcements
    match /da_notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
