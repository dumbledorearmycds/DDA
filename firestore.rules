rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared game hub documents (requests, suggestions, jackpots, event controls)
    match /da_hub/{docId} {
      allow read: if true;
      allow write: if docId in [
        'requests',
        'shopRequests',
        'suggestions',
        'jackpotEntries',
        'jjEntries',
        'eventControls',
        'globalSpin',
        'auraWeeklyReset'
      ] || docId.matches('^lb_.*') || docId.matches('^lbpending_.*');
    }

    // Individual player documents
    match /da_users/{userId} {
      allow read: if true;
      
      // Allow registration of new user documents with valid required fields
      allow create: if request.resource.data.keys().hasAll(['playerId', 'username', 'pinHash', 'coins'])
                    && request.resource.data.playerId == userId
                    && request.resource.data.coins >= 0;

      // Allow updates to user's own document
      allow update: if resource != null
                    && resource.data.playerId == userId
                    && request.resource.data.playerId == userId
                    && (!('coins' in request.resource.data) || request.resource.data.coins >= 0);

      // Delete protection
      allow delete: if resource != null;
    }

    // Dedicated card requests collection (Scalable, no 1MB doc limit)
    match /da_card_requests/{reqId} {
      allow read: if true;

      // Allow creation with valid required fields and enforce non-zero coin spend on collection requests
      allow create: if request.resource.data.keys().hasAll(['id', 'playerId', 'setIdx', 'cardIdx', 'status'])
                    && request.resource.data.id == reqId
                    && request.resource.data.status == 'pending'
                    && (
                      // CDS requests may be free (0 coins)
                      (request.resource.data.source == 'cds' && (!('coinsSpent' in request.resource.data) || request.resource.data.coinsSpent == 0))
                      // Collection requests must spend at least 100 coins
                      || (request.resource.data.source == 'collection' && ('coinsSpent' in request.resource.data) && request.resource.data.coinsSpent >= 100)
                      // Fallback for requests without explicit source tag
                      || (!('source' in request.resource.data) && (!('coinsSpent' in request.resource.data) || request.resource.data.coinsSpent >= 0))
                    );

      // Allow updates to status, notes, admin attributions, and admin clearance
      allow update: if resource != null
                    && request.resource.data.id == reqId
                    && request.resource.data.status in ['pending', 'done', 'declined'];

      // Allow deletion (cancellation by player or cleanup; safe no-op if document doesn't exist)
      allow delete: if true;
    }
  }
}
